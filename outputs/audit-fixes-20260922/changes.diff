+        def snapshot(source):
+            nonlocal calls
+            import shutil, openpyxl
+            calls+=1
+            target=self.root/'calculated.xlsx';shutil.copy2(source,target)
+            if calls==2:
+                # Models a volatile Excel formula changing on the second COM open.
