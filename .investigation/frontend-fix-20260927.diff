+    donemOzelAlan.hidden = donemFiltresi.deger !== "ozel";
+    kpiGuncelle();
+    filtrele();
+    if (donemFiltresi.deger !== "tumu" || dizgiFiltresi.deger !== "HEPSI") {
+        donemYukle(donemFiltresi.deger, true);
+    }
+})();
